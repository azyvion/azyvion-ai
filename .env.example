OPENAI_API_KEY=your_api_key_here
PORT=3000

# Optional: model your OpenAI account has access to (defaults to gpt-5-mini)
OPENAI_MODEL=gpt-5-mini

# Optional: comma-separated list of origins allowed to call the API,
# e.g. https://yourname.github.io — leave unset to allow all origins.
ALLOWED_ORIGINS=
